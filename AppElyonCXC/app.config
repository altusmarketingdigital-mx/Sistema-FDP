<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="AppElyonCXC.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <userSettings>
    <AppElyonCXC.Properties.Settings>
      <setting name="strUsuario" serializeAs="String">
        <value />
      </setting>
      <setting name="strConn" serializeAs="String">
        <value>conFinanzas</value>
      </setting>
      <setting name="UrlSeguridad" serializeAs="String">
        <value>http://localhost:50997/WsCxC.asmx</value>
      </setting>
      <setting name="UrlCuentas" serializeAs="String">
        <value>http://localhost:50997/WsCuentasC.asmx</value>
      </setting>
      <setting name="strConexionM" serializeAs="String">
        <value />
      </setting>
      <setting name="strImpresora" serializeAs="String">
        <value />
      </setting>
      <setting name="str_Impresora_1" serializeAs="String">
        <value />
      </setting>
      <setting name="str_Impresora_2" serializeAs="String">
        <value />
      </setting>
      <setting name="str_Impresora_3" serializeAs="String">
        <value />
      </setting>
      <setting name="str_Impresora_4" serializeAs="String">
        <value />
      </setting>
      <setting name="str_Impresora_5" serializeAs="String">
        <value />
      </setting>
      <setting name="str_Impresora_6" serializeAs="String">
        <value />
      </setting>
    </AppElyonCXC.Properties.Settings>
  </userSettings>
  <appSettings>
    <!--PARAMETROS INICIALES DE LA APLICACION-->
    <add key="Sistemas" value="//@Adm1n1str4d0r@//" />
    <add key="IdApp" value="1" />
    <!--PARAMETROS PUBLICACION REAL-->
    <!--<add key="urlSeguridad" value="http://wsi.univa.mx/WsSeguridadELYON/WsSeguridad.asmx"/>-->
    <!--PARAMETROS PUBLICACION LOCAL-->
    <!--<add key="urlSeguridad" value="http://192.168.48.76:85/wsseguridad.asmx"/>-->
    <!--PARAMETROS DESARROLLO-->
    <add key="urlSeguridad" value="http://localhost:50997/wsCxc.asmx" />
    <add key="urlCuentasC" value="http://localhost:50997/WsCuentasC.asmx" />
    
    <add key="ClientSettingsProvider.ServiceUri" value="" />

    <add key="SEGURIDAD" value="data source=TI-MINION;initial catalog=ELYON_dbPermisosV;user id=sa;password =Abc123;Connection Timeout=8000" />
    <add key="CUENTASC" value="data source=TI-MINION;initial catalog=Tss_Inventario;user id=sa;password =Abc123;Connection Timeout=8000" />
    
  </appSettings>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supported Runtimeversion="v4.0" />
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
    
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
      </providers>
    </roleManager>
  </system.web>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="WsCuentasCSoap" />
        <binding name="WsCxCSoap" />
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://localhost:50997/WsCuentasC.asmx" binding="basicHttpBinding"
        bindingConfiguration="WsCuentasCSoap" contract="WsCuentasC.WsCuentasCSoap"
        name="WsCuentasCSoap" />
      <endpoint address="http://localhost:50997/WsCxC.asmx" binding="basicHttpBinding"
        bindingConfiguration="WsCxCSoap" contract="WsCxC.WsCxCSoap"
        name="WsCxCSoap" />
    </client>
  </system.serviceModel>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.SqlServer.ConnectionInfo" publicKeyToken="89845dcd8080cc91" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-14.0.0.0" newVersion="14.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>